<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- THIS LAYOUT WAS REFACTORED WITH HELP FROM CHATGPT -->

<AnchorPane prefHeight="720.0"
            prefWidth="1280.0"
            stylesheets="@style.css"
            styleClass="app-root"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller">

    <children>

        <GridPane AnchorPane.topAnchor="0.0"
                  AnchorPane.bottomAnchor="0.0"
                  AnchorPane.leftAnchor="0.0"
                  AnchorPane.rightAnchor="0.0"
                  vgap="10.0"
                  styleClass="main-grid">

            <padding>
                <Insets top="12.0"
                        bottom="12.0"
                        left="12.0"
                        right="12.0" />
            </padding>

            <!--
                39% ENTITY
                1% VISIBLE GUTTER
                25% BIO / ARTIFICIAL
                35% STATUS
            -->
            <columnConstraints>

                <ColumnConstraints percentWidth="39.0"
                                   hgrow="ALWAYS" />

                <ColumnConstraints percentWidth="1.0" />

                <ColumnConstraints percentWidth="25.0"
                                   hgrow="ALWAYS" />

                <ColumnConstraints percentWidth="35.0"
                                   hgrow="ALWAYS" />

            </columnConstraints>

            <rowConstraints>

                <RowConstraints percentHeight="30.0"
                                vgrow="ALWAYS" />

                <RowConstraints percentHeight="30.0"
                                vgrow="ALWAYS" />

                <RowConstraints percentHeight="25.0"
                                vgrow="ALWAYS" />

                <RowConstraints percentHeight="15.0"
                                vgrow="ALWAYS" />

            </rowConstraints>

            <children>

                <!-- ENTITY DISPLAY -->
                <StackPane GridPane.columnIndex="0"
                           GridPane.rowSpan="2"
                           styleClass="panel,entity-panel">

                    <padding>
                        <Insets top="20.0"
                                bottom="20.0"
                                left="20.0"
                                right="20.0" />
                    </padding>

                    <children>

                        <ImageView fx:id="entityImageView"
                                   fitWidth="520.0"
                                   fitHeight="520.0"
                                   preserveRatio="true"
                                   smooth="true"
                                   mouseTransparent="true" />

                    </children>

                </StackPane>

                <!-- VISIBLE SEPARATOR BETWEEN IMAGE AND STAT PANELS -->
                <Region GridPane.columnIndex="1"
                        GridPane.rowSpan="2"
                        maxWidth="1.7976931348623157E308"
                        maxHeight="1.7976931348623157E308"
                        style="-fx-background-color: #090A0D;" />

                <!-- BIOLOGICAL STATUS -->
                <VBox alignment="CENTER"
                      spacing="18.0"
                      GridPane.columnIndex="2"
                      GridPane.rowIndex="0"
                      styleClass="panel,stat-panel">

                    <padding>
                        <Insets top="20.0"
                                bottom="20.0"
                                left="20.0"
                                right="20.0" />
                    </padding>

                    <children>

                        <Label text="BIOLOGICAL STATUS"
                               styleClass="section-title" />

                        <VBox alignment="CENTER"
                              spacing="11.0"
                              styleClass="stat-list">

                            <children>

                                <Label fx:id="prideLabel"
                                       text="PRIDE"
                                       maxWidth="1.7976931348623157E308"
                                       alignment="CENTER"
                                       styleClass="stat-label" />

                                <Label fx:id="gluttonyLabel"
                                       text="GLUTTONY"
                                       maxWidth="1.7976931348623157E308"
                                       alignment="CENTER"
                                       styleClass="stat-label" />

                                <Label fx:id="slothLabel"
                                       text="SLOTH"
                                       maxWidth="1.7976931348623157E308"
                                       alignment="CENTER"
                                       styleClass="stat-label" />

                                <Label fx:id="wrathLabel"
                                       text="WRATH"
                                       maxWidth="1.7976931348623157E308"
                                       alignment="CENTER"
                                       styleClass="stat-label" />

                            </children>

                        </VBox>

                    </children>

                </VBox>

                <!-- ARTIFICIAL STATUS -->
                <VBox alignment="CENTER"
                      spacing="18.0"
                      GridPane.columnIndex="2"
                      GridPane.rowIndex="1"
                      styleClass="panel,stat-panel">

                    <padding>
                        <Insets top="20.0"
                                bottom="20.0"
                                left="20.0"
                                right="20.0" />
                    </padding>

                    <children>

                        <Label text="ARTIFICIAL STATUS"
                               styleClass="section-title" />

                        <VBox alignment="CENTER"
                              spacing="11.0"
                              styleClass="stat-list">

                            <children>

                                <Label fx:id="temperatureLabel"
                                       text="TEMPERATURE"
                                       maxWidth="1.7976931348623157E308"
                                       alignment="CENTER"
                                       styleClass="stat-label" />

                                <Label fx:id="storageLabel"
                                       text="STORAGE"
                                       maxWidth="1.7976931348623157E308"
                                       alignment="CENTER"
                                       styleClass="stat-label" />

                                <Label fx:id="powerLabel"
                                       text="POWER"
                                       maxWidth="1.7976931348623157E308"
                                       alignment="CENTER"
                                       styleClass="stat-label" />

                                <Label fx:id="integrityLabel"
                                       text="INTEGRITY"
                                       maxWidth="1.7976931348623157E308"
                                       alignment="CENTER"
                                       styleClass="stat-label" />

                            </children>

                        </VBox>

                    </children>

                </VBox>

                <!-- STATUS -->
                <VBox GridPane.columnIndex="3"
                      GridPane.rowSpan="3"
                      styleClass="panel,status-panel">

                    <padding>
                        <Insets top="10.0"
                                bottom="10.0"
                                left="10.0"
                                right="10.0" />
                    </padding>

                    <children>

                        <ScrollPane fx:id="statusScrollPane"
                                    fitToWidth="true"
                                    VBox.vgrow="ALWAYS"
                                    styleClass="terminal-scroll">

                            <content>

                                <VBox fx:id="statusBox"
                                      spacing="7.0"
                                      styleClass="status-box" />

                            </content>

                        </ScrollPane>

                    </children>

                </VBox>

                <!-- DIALOGUE -->
                <VBox GridPane.columnIndex="0"
                      GridPane.columnSpan="3"
                      GridPane.rowIndex="2"
                      styleClass="panel,dialogue-panel">

                    <padding>
                        <Insets top="10.0"
                                bottom="10.0"
                                left="10.0"
                                right="10.0" />
                    </padding>

                    <children>

                        <ScrollPane fx:id="dialogueScrollPane"
                                    fitToWidth="true"
                                    fitToHeight="true"
                                    VBox.vgrow="ALWAYS"
                                    styleClass="terminal-scroll,dialogue-scroll">

                            <content>

                                <VBox fx:id="dialogueBox"
                                      spacing="9.0"
                                      styleClass="dialogue-box" />

                            </content>

                        </ScrollPane>

                    </children>

                </VBox>

                <!-- OPTIONS -->
                <VBox GridPane.columnIndex="0"
                      GridPane.columnSpan="4"
                      GridPane.rowIndex="3"
                      styleClass="panel,control-panel">

                    <padding>
                        <Insets top="8.0"
                                bottom="8.0"
                                left="8.0"
                                right="8.0" />
                    </padding>

                    <children>

                        <!-- BUTTONS MUST REMAIN DIRECT CHILDREN OF THIS GRIDPANE -->
                        <GridPane hgap="7.0"
                                  VBox.vgrow="ALWAYS"
                                  styleClass="control-grid">

                            <columnConstraints>

                                <ColumnConstraints percentWidth="12.5" />
                                <ColumnConstraints percentWidth="12.5" />
                                <ColumnConstraints percentWidth="12.5" />
                                <ColumnConstraints percentWidth="12.5" />
                                <ColumnConstraints percentWidth="12.5" />
                                <ColumnConstraints percentWidth="12.5" />
                                <ColumnConstraints percentWidth="12.5" />
                                <ColumnConstraints percentWidth="12.5" />

                            </columnConstraints>

                            <rowConstraints>
                                <RowConstraints percentHeight="100.0" />
                            </rowConstraints>

                            <children>

                                <Button text="SUPPRESS"
                                        mnemonicParsing="false"
                                        onAction="#suppress"
                                        maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308"
                                        GridPane.columnIndex="0" />

                                <Button text="COOLANT"
                                        mnemonicParsing="false"
                                        onAction="#coolant"
                                        maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308"
                                        GridPane.columnIndex="1" />

                                <Button text="STIMULATE"
                                        mnemonicParsing="false"
                                        onAction="#stimulate"
                                        maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308"
                                        GridPane.columnIndex="2" />

                                <Button text="CHARGE"
                                        mnemonicParsing="false"
                                        onAction="#charge"
                                        maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308"
                                        GridPane.columnIndex="3" />

                                <Button text="PURGE"
                                        mnemonicParsing="false"
                                        onAction="#purge"
                                        maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308"
                                        GridPane.columnIndex="4" />

                                <Button text="REPAIR"
                                        mnemonicParsing="false"
                                        onAction="#repair"
                                        maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308"
                                        GridPane.columnIndex="5" />

                                <Button text="NOURISH"
                                        mnemonicParsing="false"
                                        onAction="#nourish"
                                        maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308"
                                        GridPane.columnIndex="6" />

                                <Button text="RESTRAIN"
                                        mnemonicParsing="false"
                                        onAction="#restrain"
                                        maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308"
                                        GridPane.columnIndex="7" />

                            </children>

                        </GridPane>

                    </children>

                </VBox>

            </children>

        </GridPane>

        <!-- RIVER / INTRO TRANSITION OVERLAY -->
        <StackPane fx:id="transitionPane"
                   visible="false"
                   opacity="0.0"
                   styleClass="overlay-pane"
                   AnchorPane.topAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0">

            <children>

                <VBox fx:id="transitionContent"
                      alignment="CENTER"
                      spacing="22.0"
                      opacity="0.0"
                      maxWidth="1000.0"
                      translateY="-35.0">

                    <children>

                        <ImageView fx:id="riverTransitionImage"
                                   fitWidth="650.0"
                                   fitHeight="400.0"
                                   preserveRatio="true"
                                   smooth="true" />

                        <Label fx:id="transitionTitle"
                               text="SESSION INITIALIZING"
                               textFill="WHITE"
                               wrapText="true"
                               alignment="CENTER"
                               textAlignment="CENTER"
                               maxWidth="900.0" />

                        <Label fx:id="transitionQuote"
                               text="Transition quote"
                               textFill="WHITE"
                               wrapText="true"
                               alignment="CENTER"
                               textAlignment="CENTER"
                               maxWidth="900.0" />

                        <Label fx:id="transitionFooter"
                               text="OBSERVE CAREFULLY"
                               textFill="WHITE"
                               wrapText="true"
                               alignment="CENTER"
                               textAlignment="CENTER"
                               maxWidth="900.0" />

                    </children>

                </VBox>

            </children>

        </StackPane>

        <!-- GAME OVER OVERLAY -->
        <StackPane fx:id="gameOverPane"
                   visible="false"
                   opacity="0.0"
                   styleClass="overlay-pane"
                   AnchorPane.topAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0">

            <children>

                <VBox fx:id="gameOverContent"
                      alignment="CENTER"
                      spacing="18.0"
                      maxWidth="1200.0">

                    <children>

                        <ImageView fx:id="gameOverImage"
                                   fitWidth="1000.0"
                                   fitHeight="600.0"
                                   preserveRatio="true"
                                   smooth="true" />

                        <Label fx:id="gameOverText"
                               text="GAME OVER"
                               textFill="WHITE"
                               wrapText="true"
                               alignment="CENTER"
                               textAlignment="CENTER"
                               maxWidth="1000.0" />

                    </children>

                </VBox>

            </children>

        </StackPane>

    </children>

</AnchorPane>